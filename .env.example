# Copy this file to ".env" and fill in your own values.
# Never commit your real ".env" file to GitHub.

# Port the server runs on
PORT=4000

# The public URL of your site once deployed (used for Paystack redirect).
# For local development this can stay as-is.
CLIENT_URL=http://localhost:4000

# A long, random string used to sign login sessions.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# Paystack keys (from https://dashboard.paystack.com/#/settings/developer)
# Leave these blank to run in "demo mode": orders are still created and you
# still get the bank details + WhatsApp handoff, but no real card/transfer
# payment is processed through Paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# A private key of your choosing, used to protect the simple admin endpoints
# (e.g. updating stock counts). Send it as the "x-admin-key" header.
ADMIN_KEY=replace-this-with-your-own-admin-key

# Your business's bank / payment details, shown to customers
BUSINESS_NAME=Snack Corner
BANK_NAME=OPay
ACCOUNT_NAME=Okoh Christy Oyiwodu
ACCOUNT_NUMBER=8161393742
PHONE_DISPLAY=0816 139 3742
WHATSAPP_NUMBER=2348161393742
